# Run from backend/; all relative storage paths resolve from repository root.
DATABASE_PATH=data/screening.db
CORPUS_PATH=data/hundred-page-ml.pdf
# practice = deterministic scaffolding, not an LLM interview.
# llm = real dynamic generation; failures are visible and retriable.
GENERATION_MODE=practice
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=ollama
LLM_TIMEOUT=90
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
QUESTION_COUNT=3
